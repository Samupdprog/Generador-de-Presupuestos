{
  "name": "generador-de-presupuestos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace @quotes/web",
    "dev:api": "npm run dev --workspace @quotes/api",
    "dev:mcp": "npm run dev --workspace @quotes/mcp",
    "dev:worker": "npm run dev --workspace @quotes/worker",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build"
  }
}
